{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@astudioplus/codegraph-mcp",
        "--mcp",
        "--exclude",
        ".git",
        "--exclude",
        ".gradle",
        "--exclude",
        "build",
        "--exclude",
        "run",
        "--exclude",
        "node_modules",
        "--max-files",
        "10000"
      ],
      "environment": {
        "CODEGRAPH_TELEMETRY": "off"
      },
      "enabled": true,
      "timeout": 30000
    }
  }
}
